@model Mahasiswa

@{
    ViewData["Title"] = "Delete";
    var keyMappings = new Dictionary<string, Func<Mahasiswa, object>>
{
    { "NIM", item => item.NIM },
    { "FirstName", item => item.FirstName },
    { "LastName", item => item.LastName },
    { "Semester", item => item.Semester },
    { "FotoProfil", item => item.FotoProfil },
    { "NamaProgramStudi", item => item.IdProgramStudi },
    { "IdKonsentrasi", item => item.IdKonsentrasi },
    { "IdProyek", item => item.IdProyek },
    { "CreatedAt", item => item.CreatedAt },
    { "UpdatedAt", item => item.UpdatedAt },
};
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Admin</h4>
    <hr />
    <dl class="row gap-2">
        @foreach(var map in keyMappings)
        {
            <dt class="col-sm-2">@map.Key</dt>
            <dd class="col-sm-10">@map.Value</dd>
        }
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
