@model Mahasiswa

@{
    ViewData["Title"] = "Delete";
    var details = new Dictionary<string, string>
    {
        { "NIM", Model.NIM },
        { "First Name", Model.FirstName },
        { "Last Name", Model.LastName },
        { "Tanggal Lahir", Model.TanggalLahir.ToString("yyyy-MM-dd") },
        { "Foto Profil", Model.FotoProfil },
        { "Program Studi", Model.ProgramStudi?.Nama },
        { "Konsentrasi", Model.Konsentrasi?.Nama },
        { "Semester", Model.Semester.ToString() }
    };
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Admin</h4>
    <hr />
    <dl class="row">
        @foreach(var map in details)
        {
            <dt class="col-sm-2">@map.Key</dt>
            <dd class="col-sm-10">@map.Value</dd>
        }
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
