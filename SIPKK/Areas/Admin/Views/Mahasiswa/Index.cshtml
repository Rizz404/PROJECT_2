@model IEnumerable<Mahasiswa>

@{
    ViewData["Title"] = "Index";
    int counter = 1;
}

<h1>Mahasiswa</h1>

<p>
    <a asp-action="Create">Create Mahasiswa</a>
</p>

<div class="table-responsive">
    <table class="table table-striped align-middle text-center">
        <thead>
            <tr>
                <th>No</th>
                <th>@Html.DisplayNameFor(model => model.NIM)</th>
                <th>@Html.DisplayNameFor(model => model.FirstName)</th>
                <th>@Html.DisplayNameFor(model => model.LastName)</th>
                <th>@Html.DisplayNameFor(model => model.TanggalLahir)</th>
                <th>@Html.DisplayNameFor(model => model.FotoProfil)</th>
                <th>@Html.DisplayNameFor(model => model.IdProgramStudi)</th>
                <th>@Html.DisplayNameFor(model => model.IdKonsentrasi)</th>
                <th>@Html.DisplayNameFor(model => model.Semester)</th>
                <th>@Html.DisplayNameFor(model => model.Persyaratan)</th>
                <th>@Html.DisplayNameFor(model => model.IdProyek)</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                var persyaratanTerpenuhi = item.Persyaratan != null &&
                item.Persyaratan.KetSehat &&
                item.Persyaratan.KetPembayaran &&
                item.Persyaratan.KetOrangTua &&
                item.Persyaratan.KetKelakuanBaik;
                <tr>
                    <td>@counter</td>
                    <td>@item.NIM</td>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>@item.TanggalLahir</td>
                    <td>@item.FotoProfil</td>
                    <td>@item.ProgramStudi.Nama</td>
                    <td>@item.Konsentrasi.Nama</td>
                    <td>@item.Semester</td>
                    <td>
                        @if(persyaratanTerpenuhi)
                        {
                            <span>Terpenuhi</span>
                        }
                        else
                        {
                            <a asp-area="Admin" asp-controller="Persyaratan" asp-action="Edit" asp-route-id="@item.Persyaratan?.Id">Belum Terpenuhi</a>
                        }
                    </td>
                    <td>
                        @if(item.Proyek != null)
                        {
                            @item.Proyek.NamaProyek
                        }
                        else
                        {
                            <span>Belum Mendaftar</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
                counter++;
            }
        </tbody>
    </table>
</div>