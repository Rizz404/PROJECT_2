@model Mahasiswa

@{
    ViewData["Title"] = "Details";
    var details = new Dictionary<string, string>
    {
        { "NIM", Model.NIM },
        { "First Name", Model.FirstName },
        { "Last Name", Model.LastName },
        { "Tanggal Lahir", Model.TanggalLahir.ToString("yyyy-MM-dd") },
        { "Foto Profil", Model.FotoProfil },
        { "Program Studi", Model.ProgramStudi?.Nama },
        { "Konsentrasi", Model.Konsentrasi?.Nama },
        { "Semester", Model.Semester.ToString() }
    };
}

<h1>Details</h1>

<div>
    <h4>Mahasiswa</h4>
    <hr />
    <dl class="row">
        @foreach(var prop in details)
        {
            <dt class="col-sm-2">@prop.Key</dt>
            <dd class="col-sm-10">@prop.Value</dd>
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
