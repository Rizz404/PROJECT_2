@model Mahasiswa

@{
    ViewData["Title"] = "Details";
}
<div class="hidden">
<h1>Details</h1>

<div>
    <h4>Mahasiswa</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NIM)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NIM)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FirstName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FirstName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.LastName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LastName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TanggalLahir)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TanggalLahir)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FotoProfil)
        </dt>
        <dd class="col-sm-10">
            <img src="@Model.FotoProfil" />
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ProgramStudi.Nama)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProgramStudi.Nama)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Konsentrasi.Nama)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Konsentrasi.Nama)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Semester)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Semester)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
</div>

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="card-title text-center mb-4">Mahasiswa Details</h1>
                    <div class="row">
                        <div class="col-md-4 mb-4">
                            @if(Model.FotoProfil != null)
                            {
                                <img src="@Model.FotoProfil" class="img-fluid rounded" alt="@Model.FirstName @Model.LastName" />
                            }else
                            {
                                <img src="data:image/png;base64," alt="Foto Profil" class="profile-pic rounded-circle" />
                            }
                        </div>
                        <div class="col-md-8">
                            <h2 class="mb-3">@Model.FirstName @Model.LastName</h2>
                            <p class="lead">NIM: @Model.NIM</p>
                            <p><strong>Date of Birth:</strong> @Model.TanggalLahir.ToString("dd MMMM yyyy")</p>
                            <p><strong>Program Studi:</strong> @Model.ProgramStudi.Nama</p>
                            <p><strong>Konsentrasi:</strong> @Model.Konsentrasi.Nama</p>
                            <p><strong>Semester:</strong> @Model.Semester</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
