@model SIPKK.Models.ViewModels.BiayaOperasionalVM

@{
    ViewData["Title"] = "Upsert";
}

<h1>@(!string.IsNullOrEmpty(Model.BiayaOperasional.Id) ? "Update" : "Create")</h1>

<h4>BiayaOperational</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Upsert">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="BiayaOperasional.Id" hidden value="@(Model.BiayaOperasional.Id ?? "")" />
            <div class="form-group">
                <label asp-for="BiayaOperasional.IdProyek" class="control-label"></label>
                <select asp-for="BiayaOperasional.IdProyek" asp-items="Model.ProyekList" class="form-select">
                    <option disabled selected>Pilih Proyek</option>
                </select>
                <span asp-validation-for="BiayaOperasional.IdProyek" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BiayaOperasional.BiayaTransportasi" class="control-label"></label>
                <input asp-for="BiayaOperasional.BiayaTransportasi" class="form-control" />
                <span asp-validation-for="BiayaOperasional.BiayaTransportasi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BiayaOperasional.BiayaProyek" class="control-label"></label>
                <input asp-for="BiayaOperasional.BiayaProyek" class="form-control" />
                <span asp-validation-for="BiayaOperasional.BiayaProyek" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BiayaOperasional.BiayaDll" class="control-label"></label>
                <input asp-for="BiayaOperasional.BiayaDll" class="form-control" />
                <span asp-validation-for="BiayaOperasional.BiayaDll" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BiayaOperasional.Keterangan" class="control-label"></label>
                <input asp-for="BiayaOperasional.Keterangan" class="form-control" />
                <span asp-validation-for="BiayaOperasional.Keterangan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BiayaOperasional.TanggalBiaya" class="control-label"></label>
                <input asp-for="BiayaOperasional.TanggalBiaya" class="form-control" />
                <span asp-validation-for="BiayaOperasional.TanggalBiaya" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">@(!string.IsNullOrEmpty(Model.BiayaOperasional.Id) ? "Update" : "Create")</button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}