@model KonsentrasiVM

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>BiayaOperational</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Konsentrasi.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Konsentrasi.IdProgramStudi" class="control-label"></label>
                <select asp-for="@Model.Konsentrasi.IdProgramStudi" asp-items="@Model.ProgramStudiList" class="form-select">
                    <option disabled selected>Pilih Prodi</option>
                </select>
                <span asp-validation-for="Konsentrasi.IdProgramStudi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Konsentrasi.Nama" class="control-label">
                    Nama Konsentrasi
                </label>
                <input asp-for="Konsentrasi.Nama" class="form-control" />
                <span asp-validation-for="Konsentrasi.Nama" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Konsentrasi.Deskripsi" class="control-label"></label>
                <input asp-for="Konsentrasi.Deskripsi" class="form-control" />
                <span asp-validation-for="Konsentrasi.Deskripsi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Edit" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}