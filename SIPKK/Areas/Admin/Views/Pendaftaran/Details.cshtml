@model Pendaftaran

@{
    ViewData["Title"] = "Details";
    var keyMappings = new Dictionary<string, Func<Pendaftaran, object>>
    {
        { "TanggalPendaftaran", item => item.TanggalPendaftaran },
        { "StatusPembayaran", item => item.StatusPembayaran },
        { "CreatedAt", item => item.CreatedAt },
        { "UpdatedAt", item => item.UpdatedAt }
    };
}

<h1>Details</h1>

<div>
    <h4>Pendaftaran</h4>
    <hr />
    <dl class="row">
        @foreach (var map in keyMappings)
        {
            <dt class="col-sm-2">@map.Key</dt>
            <dd class="col-sm-10">@map.Value(Model)</dd>
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
