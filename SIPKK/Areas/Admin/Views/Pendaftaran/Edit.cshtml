@model PendaftaranVM

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Pendaftaran</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Pendaftaran.IdMahasiswa" class="control-label"></label>
                <select asp-for="@Model.Pendaftaran.IdMahasiswa" class="form-control" asp-items="@Model.MahasiswaList"></select>
                <span asp-validation-for="Pendaftaran.IdMahasiswa" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Pendaftaran.TanggalPendaftaran" class="control-label"></label>
                <input asp-for="Pendaftaran.TanggalPendaftaran" class="form-control" />
                <span asp-validation-for="Pendaftaran.TanggalPendaftaran" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Pendaftaran.Status" class="control-label"></label>
                <input asp-for="Pendaftaran.Status" class="form-control" />
                <span asp-validation-for="Pendaftaran.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Pendaftaran.Id" class="control-label"></label>
                <input asp-for="Pendaftaran.Id" class="form-control" />
                <span asp-validation-for="Pendaftaran.Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Edit" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
