@model PendaftaranVM

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Pendaftaran</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Pendaftaran.IdMahasiswa" class="control-label"></label>
                <select asp-for="@Model.Pendaftaran.IdMahasiswa" class="form-control" asp-items="@Model.MahasiswaList"></select>
                <span asp-validation-for="Pendaftaran.IdMahasiswa" class="text-danger"></span>
            </div>  
            <div class="form-group">
                <label asp-for="Pendaftaran.IdProyek" class="control-label"></label>
                <select asp-for="@Model.Pendaftaran.IdProyek" class="form-control" asp-items="@Model.ProyekList"></select>
                <span asp-validation-for="Pendaftaran.IdProyek" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Pendaftaran.TanggalPendaftaran" class="control-label"></label>
                <input asp-for="Pendaftaran.TanggalPendaftaran" class="form-control" />
                <span asp-validation-for="Pendaftaran.TanggalPendaftaran" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Pendaftaran.StatusPembayaran" class="control-label"></label>
                <select asp-for="Pendaftaran.StatusPembayaran" class="form-control">
                    <option value="false">Belum</option>
                    <option value="true">Sudah</option>
                </select>
                <span asp-validation-for="Pendaftaran.StatusPembayaran" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
