@model IEnumerable<Pendaftaran>

@{
    ViewData["Title"] = "Index";
    int counter = 1;
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>No</th>
            <th>@Html.DisplayNameFor(model => model.Mahasiswa.FirstName)</th>
            <th>@Html.DisplayNameFor(model => model.Proyek.NamaProyek)</th>
            <th>@Html.DisplayNameFor(model => model.TanggalPendaftaran)</th>
            <th>@Html.DisplayNameFor(model => model.StatusPembayaran)</th>
            <th>@Html.DisplayNameFor(model => model.BuktiPembayaran)</th>
            <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
            <th>@Html.DisplayNameFor(model => model.UpdatedAt)</th>
            <th>Opsi</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@counter</td>
                <td>@item.Mahasiswa.FirstName</td>
                <td>@item.Proyek.NamaProyek</td>
                <td>@item.TanggalPendaftaran</td>
                <td>@item.StatusPembayaran</td>
                <td>
                    @if(@item.BuktiPembayaran != null)
                    {
                        <img src="@item.BuktiPembayaran" alt="Alternate Text" />
                    }
                    else
                    {
                        <span>My ass</span>
                    }
                </td>
                <td>@item.CreatedAt</td>
                <td>@item.UpdatedAt</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
            counter++;
        }
    </tbody>
</table>
