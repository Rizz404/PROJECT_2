@model LaporanVM

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Laporan</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Laporan.IdProyek" class="control-label"></label>
                <select asp-for="@Model.Laporan.IdProyek" asp-items="@Model.ProyekList" class="form-select">
                    <option disabled selected>Pilih Proyek</option>
                </select>
                <span asp-validation-for="Laporan.IdProyek" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Laporan.Keterangan" class="control-label"></label>
                <input asp-for="Laporan.Keterangan" class="form-control" />
                <span asp-validation-for="Laporan.Keterangan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Laporan.Id" class="control-label"></label>
                <input asp-for="Laporan.Id" class="form-control" />
                <span asp-validation-for="Laporan.Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Edit" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
