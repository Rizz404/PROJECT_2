@model IEnumerable<Laporan>

@{
    ViewData["Title"] = "Index";
    int counter = 1;
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>No</th>
            <th>
                @Html.DisplayNameFor(model => model.Mahasiswa.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Proyek.NamaProyek)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Keterangan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FotoLaporan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FileLaporan)
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@counter</td>
                <td>
                    @item.Mahasiswa.FirstName
                </td>
                <td>
                    @item.Proyek.NamaProyek
                </td>
                <td>
                    @item.Keterangan
                </td>
                <td>
                    @item.FotoLaporan
                </td>
                <td>
                    @item.FileLaporan
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
            counter++;
        }
    </tbody>
</table>
