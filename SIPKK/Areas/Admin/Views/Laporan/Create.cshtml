@model LaporanVM

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Laporan</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            @* <input asp-for="Laporan.Id" type="hidden" />
            <input asp-for="Laporan.FotoLaporan" type="hidden" />
            <input asp-for="Laporan.FileLaporan" type="hidden" /> *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Laporan.IdProyek" class="control-label"></label>
                <select asp-for="@Model.Laporan.IdProyek" asp-items="@Model.ProyekList" class="form-select">
                    <option disabled selected>Pilih Proyek</option>
                </select>
                <span asp-validation-for="Laporan.IdProyek" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Laporan.IdProyek" class="control-label"></label>
                <select asp-for="@Model.Laporan.IdMahasiswa" asp-items="@Model.MahasiswaList" class="form-select">
                    <option disabled selected>Pilih Mahasiswa</option>
                </select>
                <span asp-validation-for="Laporan.IdProyek" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Laporan.Keterangan" class="control-label"></label>
                <input asp-for="Laporan.Keterangan" class="form-control" />
                <span asp-validation-for="Laporan.Keterangan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Laporan.FotoLaporan" class="control-label"></label>
                <input asp-for="Laporan.FotoLaporan" type="file" name="img" class="form-control" />
                <span asp-validation-for="Laporan.FotoLaporan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Laporan.FileLaporan" class="control-label"></label>
                <input asp-for="Laporan.FileLaporan" type="file" name="file" class="form-control" />
                <span asp-validation-for="Laporan.FileLaporan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
