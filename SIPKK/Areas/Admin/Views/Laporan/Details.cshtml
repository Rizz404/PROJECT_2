@model Laporan

@{
    ViewData["Title"] = "Details";
    var keyMappings = new Dictionary<string, Func<Laporan, object>>
    {
        { "Keterangan", item => item.Keterangan },
        { "NamaProyek", item => item.IdProyek },
        { "CreatedAt", item => item.CreatedAt },
        { "UpdatedAt", item => item.UpdatedAt },
    };
}

<h1>Details</h1>

<div>
    <h4>Laporan</h4>
    <hr />
    <dl class="row">
        @foreach(var map in keyMappings)
        {
            <dt class="col-sm-2">@map.Key</dt>
            <dd class="col-sm-10">@map.Value</dd>
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
