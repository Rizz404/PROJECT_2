@model IEnumerable<Persyaratan>

@{
    ViewData["Title"] = "Index";
}

<h1>Persyaratan</h1>

<p>
    @* <a asp-action="Create">Create New</a> *@
</p>
<table class="table">
    <thead>
        <tr>
            <th>No</th>
            <th>@Html.DisplayNameFor(model => model.Mahasiswa)</th>
            <th>@Html.DisplayNameFor(model => model.KetSehat)</th>
            <th>@Html.DisplayNameFor(model => model.KetPembayaran)</th>
            <th>@Html.DisplayNameFor(model => model.KetOrangTua)</th>
            <th>@Html.DisplayNameFor(model => model.KetKelakuanBaik)</th>
            <th>Opsi</th>
        </tr>
    </thead>
    <tbody>
        @if(Model != null && Model.Any())
        {
            int counter = 1;
            foreach(var item in Model)
            {
                <tr>
                    <td>@counter</td>
                    <td>@item.Mahasiswa.FirstName</td>
                    <td>
                        @if (item.KetSehat)
                        {
                            <i class="fas fa-check-circle text-success"></i>
                            <span> Sudah</span>
                       }
                        else
                        {
                            <i class="fas fa-times-circle text-danger"></i>
                            <span>Belum</span>
                    }
                    </td>
                    <td>
                        @if (item.KetPembayaran)
                        {
                            <i class="fas fa-check-circle text-success"></i>
                            <span> Sudah</span>
                       }
                        else
                        {
                            <i class="fas fa-times-circle text-danger"></i>
                            <span>Belum</span>
                    }
                    </td>
                    <td>
                        @if (item.KetOrangTua)
                        {
                            <i class="fas fa-check-circle text-success"></i>
                            <span> Sudah</span>
                       }
                        else
                        {
                            <i class="fas fa-times-circle text-danger"></i>
                            <span>Belum</span>
                    }
                    </td>
                    <td>
                        @if (item.KetKelakuanBaik)
                        {
                            <i class="fas fa-check-circle text-success"></i>
                            <span> Sudah</span>
                       }
                        else
                        {
                            <i class="fas fa-times-circle text-danger"></i>
                            <span>Belum</span>
                    }
                    </td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
                counter++;
            }
        }
        else
        {
            <tr>
                <td colspan="7">No records found.</td>
            </tr>
        }
    </tbody>
</table>
