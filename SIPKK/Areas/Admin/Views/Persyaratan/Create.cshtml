@model PersyaratanVM

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Persyaratan</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Persyaratan.IdMahasiswa" class="control-label"></label>
                <select asp-for="@Model.Persyaratan.IdMahasiswa" class="form-control" asp-items="@Model.MahasiswaList"></select>
                <span asp-validation-for="Persyaratan.IdMahasiswa" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Persyaratan.KetSehat" /> @Html.DisplayNameFor(model => model.Persyaratan.KetSehat)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Persyaratan.KetPembayaran" /> @Html.DisplayNameFor(model => model.Persyaratan.KetPembayaran)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Persyaratan.KetOrangTua" /> @Html.DisplayNameFor(model => model.Persyaratan.KetOrangTua)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Persyaratan.KetKelakuanBaik" /> @Html.DisplayNameFor(model => model.Persyaratan.KetKelakuanBaik)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Persyaratan.Id" class="control-label"></label>
                <input asp-for="Persyaratan.Id" class="form-control" />
                <span asp-validation-for="Persyaratan.Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
