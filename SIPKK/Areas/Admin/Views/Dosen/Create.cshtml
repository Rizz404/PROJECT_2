<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="form-container p-5">
                <h1 class="text-center mb-4">Create Dosen</h1>
                <hr class="mb-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Dosen.NamaDosen" class="form-label"></label>
                        <input asp-for="Dosen.NamaDosen" class="form-control" placeholder="Enter Nama Dosen">
                        <span asp-validation-for="Dosen.NamaDosen" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dosen.NIDN" class="form-label"></label>
                        <input asp-for="Dosen.NIDN" class="form-control" placeholder="Enter NIDN">
                        <span asp-validation-for="Dosen.NIDN" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dosen.TanggalLahir" class="form-label"></label>
                        <input asp-for="Dosen.TanggalLahir" class="form-control" type="date">
                        <span asp-validation-for="Dosen.TanggalLahir" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dosen.IdProyek" class="form-label"></label>
                        <select asp-for="@Model.Dosen.IdProyek" asp-items="@Model.ProyekList" class="form-select">
                            <option disabled selected>Pilih Proyek</option>
                        </select>
                        <span asp-validation-for="Dosen.IdProyek" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Create</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
