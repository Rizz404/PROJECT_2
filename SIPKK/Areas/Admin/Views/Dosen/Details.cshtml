@model Dosen

@{
    ViewData["Title"] = "Detail Dosen";
    var dosenDetails = new Dictionary<string, object>
    {
        { "Nama Dosen", Model.NamaDosen },
        { "NIDN", Model.NIDN },
        { "Nama Proyek", Model.IdProyek }
    };
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Dosen</h4>
    <hr />
    <dl class="row">
        @foreach(var detail in dosenDetails)
        {
            <dt class="col-sm-2">@detail.Key</dt>
            <dd class="col-sm-10">@detail.Value</dd>
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
