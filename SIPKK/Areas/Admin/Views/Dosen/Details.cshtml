@model Dosen

@{
    ViewData["Title"] = "Detail Dosen";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Dosen</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NamaDosen)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NamaDosen)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NIDN)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NIDN)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Proyek.NamaProyek)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Proyek.NamaProyek)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TanggalLahir)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TanggalLahir)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FotoProfil)
        </dt>
        <dd class="col-sm-10">
            <img src="@Model.FotoProfil" />
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
