@model IEnumerable<Dosen>

@{
    int counter = 1;
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>No</th>
            <th>@Html.DisplayNameFor(model => model.NamaDosen)</th>
            <th>@Html.DisplayNameFor(model => model.NIDN)</th>
            <th>@Html.DisplayNameFor(model => model.Proyek.NamaProyek)</th>
            <th>@Html.DisplayNameFor(model => model.TanggalLahir)</th>
            <th>@Html.DisplayNameFor(model => model.FotoProfil)</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@counter</td>
                <td>@item.NamaDosen</td>
                <td>@item.NIDN</td>
                <td>
                    @if(item.Proyek != null && item.Proyek.NamaProyek != null)
                    {
                        <span>@item.Proyek.NamaProyek</span>
                    }
                    else
                    {
                        <span>Belum ambil proyek</span>
                    }
                </td>
                <td>@item.TanggalLahir</td>
                <td>
                    @if(item.FotoProfil != null)
                    {
                        <img src="@item.FotoProfil" />
                    }
                    else
                    {
                        <span>Kont</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
            counter++;
        }
    </tbody>
</table>
