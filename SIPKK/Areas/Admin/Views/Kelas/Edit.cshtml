@model KelasVM

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>BiayaOperational</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Kelas.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Kelas.Nama" class="control-label"></label>
                <input asp-for="Kelas.Nama" class="form-control" />
                <span asp-validation-for="Kelas.Nama" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Kelas.Deskripsi" class="control-label"></label>
                <input asp-for="Kelas.Deskripsi" class="form-control" />
                <span asp-validation-for="Kelas.Deskripsi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Edit" class="btn" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}