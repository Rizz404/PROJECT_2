@model ProyekVM

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Proyek</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <input asp-for="Proyek.Id" type="hidden" />
            <input asp-for="Proyek.FotoProyek" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Proyek.NamaProyek" class="control-label"></label>
                <input asp-for="Proyek.NamaProyek" class="form-control" />
                <span asp-validation-for="Proyek.NamaProyek" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Proyek.FotoProyek" class="control-label"></label>
                <input asp-for="Proyek.FotoProyek" type="file" name="file" class="form-control" />
                <span asp-validation-for="Proyek.FotoProyek" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Proyek.Deskripsi" class="control-label"></label>
                <input asp-for="Proyek.Deskripsi" class="form-control" />
                <span asp-validation-for="Proyek.Deskripsi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Proyek.TanggalMulai" class="control-label"></label>
                <input asp-for="Proyek.TanggalMulai" class="form-control" />
                <span asp-validation-for="Proyek.TanggalMulai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Proyek.TanggalSelesai" class="control-label"></label>
                <input asp-for="Proyek.TanggalSelesai" class="form-control" />
                <span asp-validation-for="Proyek.TanggalSelesai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Proyek.Lokasi" class="control-label"></label>
                <input asp-for="Proyek.Lokasi" class="form-control" />
                <span asp-validation-for="Proyek.Lokasi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Proyek.Kuota" class="control-label"></label>
                <input asp-for="Proyek.Kuota" class="form-control" />
                <span asp-validation-for="Proyek.Kuota" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Proyek.Verified" class="control-label"></label>
                <select asp-for="Proyek.Verified" class="form-control">
                    <option value="false">False</option>
                    <option value="true">True</option>
                </select>
                <span asp-validation-for="Proyek.Verified" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Proyek.SudahSelesai" class="control-label"></label>
                <select asp-for="Proyek.SudahSelesai" class="form-control">
                    <option value="false">Belum</option>
                    <option value="true">Sudah</option>
                </select>
                <span asp-validation-for="Proyek.SudahSelesai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
