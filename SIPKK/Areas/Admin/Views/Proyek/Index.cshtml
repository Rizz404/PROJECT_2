@model IEnumerable<Proyek>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NamaProyek)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Deskripsi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FotoProyek)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TanggalMulai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TanggalSelesai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lokasi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Kuota)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Verified)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SudahSelesai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedAt)
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.NamaProyek)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Deskripsi)
                </td>
                <td>
                    <img src="@Html.DisplayFor(modelItem => item.FotoProyek)" alt="@Html.DisplayFor(modelItem => item.FotoProyek)" />
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TanggalMulai)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TanggalSelesai)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Lokasi)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Kuota)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Verified)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SudahSelesai)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedAt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UpdatedAt)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
