@model IEnumerable<Proyek>

@{
    ViewData["Title"] = "Index";
}

<h1>Proyek</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NamaProyek)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Deskripsi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FotoProyek)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TanggalMulai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TanggalSelesai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Lokasi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Kuota)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipeProyek)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Verified)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SudahSelesai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedAt)
            </th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>
                    @item.NamaProyek
                </td>
                <td>
                    @item.Deskripsi
                </td>
                <td>
                    @if(@item.FotoProyek != null)
                    {
                        <img src="@item.FotoProyek" alt="@item.NamaProyek" class="profile-pic rounded-circle table-foto" />
                    } else
                    {
                        <img class="profile-pic rounded-circle table-foto" style="width: 46px; height:46px; border-radius: 8px"
                             src="~/images/contextual/project.svg" alt="Diagram program KKN dan KKP" class="profile-pic rounded-circle" />

                    }
                </td>
                <td>
                    @item.TanggalMulai
                </td>
                <td>
                    @item.TanggalSelesai
                </td>
                <td>
                    @item.Lokasi
                </td>
                <td>
                  @item.Mahasiswa.Count /  @item.Kuota
                </td> 
                <td>
                  @item.TipeProyek
                </td>
                <td>
                    @item.Verified
                </td>
                <td>
                    @if (item.SudahSelesai)
                    {
                        <span> Sudah</span>
                    }
                    else
                    {
                        <span>Belum</span>
                    }
                </td>
                <td>
                    @item.CreatedAt
                </td>
                <td>
                    @item.UpdatedAt
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
