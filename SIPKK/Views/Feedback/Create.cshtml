@model FeedbackVM

<div class="container mt-5">
    <h2 class="mb-4">Buat Feedback</h2>
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <input type="hidden" asp-for="Feedback.IdDosen" />
        <input type="hidden" asp-for="Feedback.IdKelompok" />
        <input type="hidden" asp-for="Feedback.IdMahasiswa" />

        <div class="form-group">
            <label asp-for="Feedback.Comment" class="control-label">
                Nama Feedback
            </label>
            <input asp-for="Feedback.Comment" class="form-control" />
            <span asp-validation-for="Feedback.Comment" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </form>
</div>
