@model LaporanVM

<div class="container mt-5">
    <h2 class="mb-4">Buat Laporan</h2>
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <input type="hidden" asp-for="Laporan.Id" />
        <input type="hidden" asp-for="Laporan.IdProyek" />
        <input type="hidden" asp-for="Laporan.IdKelompok" />
        <input type="hidden" asp-for="Laporan.IdMahasiswa" />
        <input type="hidden" asp-for="Laporan.Keterangan" />

        <div class="form-group">
            <label asp-for="Laporan.Feedback" class="control-label"></label>
            <input asp-for="Laporan.Feedback" class="form-control" />
            <span asp-validation-for="Laporan.Feedback" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </form>
</div>
