@model PendaftaranVM

<h2>Upload bukti pembayaran</h2>

<form asp-action="UploadBiayaPendaftaran" method="post" enctype="multipart/form-data" class="row">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Pendaftaran.IdProyek" />
    <input type="hidden" asp-for="Pendaftaran.IdMahasiswa" />
    <input type="hidden" asp-for="Pendaftaran.StatusPembayaran" />
    <input type="hidden" asp-for="Pendaftaran.TanggalPendaftaran" />
    <div class="form-group">
        <label asp-for="Pendaftaran.BuktiPembayaran" class="control-label"></label>
        <input asp-for="Pendaftaran.BuktiPembayaran" type="file" name="file" class="form-control" accept="image/*" required />
        <span asp-validation-for="Pendaftaran.BuktiPembayaran" class="text-danger"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>
</form>