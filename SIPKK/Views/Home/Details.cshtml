@model Proyek

<div class="row">
    <div class="">
        @if(TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
        @if(TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        <div class="card">
            <img src="~/images/contextual/project.svg" class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title">@Model.NamaProyek</h5>
                <p class="card-text">@Model.Deskripsi</p>
                <div class="my-2 d-flex gap-2 flex-wrap">
                    <button class="btn btn-danger badge">@Model.Kuota</button>
                    <button class="btn btn-danger badge">@Model.Lokasi</button>
                </div>
                <form asp-action="Daftar" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary">Daftar</button>
                </form>
            </div>
        </div>
        <ul class="list-group mb-2">
            @foreach(var mahasiswa in Model.Mahasiswa)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @mahasiswa.FirstName
                    <span>Pending</span>
                </li>
            }

        </ul>
    </div>
</div>