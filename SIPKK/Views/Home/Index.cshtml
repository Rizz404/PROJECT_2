        </h3>
        <div class="row">
            @foreach(var proyek in Model)
            {
                @if(proyek.SudahSelesai)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100">
                            @if(proyek.FotoProyek != null)
                            {
                                <img src="@Html.DisplayFor(modelItem => proyek.FotoProyek)" class="landing-page-foto" alt="@Html.DisplayFor(modelItem => proyek.FotoProyek)" />

                            }
                            else
                            {
                                <img src="https://i.pinimg.com/736x/87/20/2f/87202f0fc6edd3524e49679bea430025.jpg" class="landing-page-foto" alt="No Image" />
                            }
                            <div class="card-body">
                                <h4 class="card-title">
