                        <path d="M1.125 18C1.125 27.3198 8.68019 34.875 18 34.875C27.3198 34.875 34.875 27.3198 34.875 18C34.875 8.68019 27.3198 1.125 18 1.125C8.68019 1.125 1.125 8.68019 1.125 18Z" fill="#C2E4FF" />
                        <path d="M18.9562 27L27.5625 18L18.9563 9L18.9562 14.9625L8.4375 14.9625L8.4375 20.7562L18.9562 20.7563L18.9562 27Z" fill="white" />
                    </svg>
                </a>

            </div>

        </div>
        <img src="~/images/assets/below-hero.png" />
    </section>
    <section class="container py-5">
        <h3 class="h3 mb-4 text-center">
