@model IEnumerable<Proyek>
@{ ViewData["Title"] = "Sistem Informasi KKN/KKP"; }
<partial name="_Notification" />
<section style="max-width:1200px;margin:48px auto;padding:36px;background:#e8f2ef;border-radius:24px;display:flex;gap:32px;align-items:center;flex-wrap:wrap">
    <div style="flex:1;min-width:300px">
        <p style="color:#1d6754;font-weight:700;letter-spacing:.1em">SIPKK · KKN / KKP</p>
        <h1 style="font-size:44px;line-height:1.15;color:#13382e">Temukan program pengabdian yang sesuai.</h1>
        <p style="font-size:18px;color:#34564d">Jelajahi proyek KKN dan KKP, lihat lokasi serta kuota, lalu lengkapi pendaftaran melalui akun mahasiswa.</p>
        <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:24px">
            <a class="primary-btn" asp-controller="Proyek" asp-action="Index">Jelajahi Proyek</a>
            <a class="primary-btn" asp-area="Identity" asp-page="/Account/RegisterMahasiswa">Daftar Mahasiswa</a>
        </div>
    </div>
    <img src="~/images/contextual/project.svg" width="440" height="264" style="max-width:100%;border-radius:20px" alt="Diagram program pengabdian KKN dan KKP" />
</section>
<section style="max-width:1200px;margin:40px auto;padding:0 24px">
    <h2 style="color:#13382e">Program Selesai</h2>
    <p>Informasi kegiatan KKN dan KKP yang telah selesai.</p>
    @if (!Model.Any())
    {
        <div style="padding:24px;background:white;border:1px solid #d1ddd7;border-radius:16px">
            <p>Belum ada program yang tercatat selesai. Lihat daftar proyek untuk informasi kegiatan yang tersedia.</p>
            <a asp-area="" asp-controller="Proyek" asp-action="Index">Jelajahi proyek KKN / KKP →</a>
        </div>
    }
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:20px">
        @foreach (var proyek in Model.Take(6))
        {
            <article style="background:white;border:1px solid #d1ddd7;border-radius:16px;padding:24px">
                <span style="color:#1d6754;font-weight:700">@proyek.TipeProyek · @proyek.Lokasi</span>
                <h3 style="font-size:21px;margin-top:14px">@proyek.NamaProyek</h3>
                <p>@proyek.Deskripsi</p>
                <p style="font-weight:600">Kuota @proyek.Kuota peserta</p>
                <a asp-area="" asp-controller="Proyek" asp-action="Details" asp-route-id="@proyek.Id">Lihat informasi proyek →</a>
            </article>
        }
    </div>
</section>
