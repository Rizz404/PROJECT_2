@model BiayaOperasionalVM

@{
    ViewData["Title"] = "Create Laporan";
}


<form asp-action="CreateBiayaOperasional" method="post" enctype="multipart/form-data" class="base-container">
<h2>Create Biaya Operasional</h2>
    <input type="hidden" asp-for="BiayaOperasional.IdMahasiswa" />
    <input type="hidden" asp-for="BiayaOperasional.IdProyek" />
    <input type="hidden" asp-for="BiayaOperasional.TanggalBiaya" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="BiayaOperasional.Keterangan" class="form-label"></label>
        <input asp-for="BiayaOperasional.Keterangan" class="form-control" />
        <span asp-validation-for="BiayaOperasional.Keterangan" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BiayaOperasional.BiayaProyek" class="form-label"></label>
        <input asp-for="BiayaOperasional.BiayaProyek" class="form-control" />
        <span asp-validation-for="BiayaOperasional.BiayaProyek" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BiayaOperasional.BiayaTransportasi" class="form-label"></label>
        <input asp-for="BiayaOperasional.BiayaTransportasi" class="form-control" />
        <span asp-validation-for="BiayaOperasional.BiayaTransportasi" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BiayaOperasional.BiayaDll" class="form-label"></label>
        <input asp-for="BiayaOperasional.BiayaDll" class="form-control" />
        <span asp-validation-for="BiayaOperasional.BiayaDll" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <input type="submit" value="Create" class="btn btn-primary" />
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
