@model LaporanVM

@{
    ViewData["Title"] = "Create Laporan";
}
<div class="hidden">
<h2>Create Laporan</h2>

<form asp-action="CreateLaporan" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Laporan.IdMahasiswa" />
    <input type="hidden" asp-for="Laporan.IdProyek" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Laporan.Keterangan" class="control-label"></label>
        <input asp-for="Laporan.Keterangan" class="form-control" />
        <span asp-validation-for="Laporan.Keterangan" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Laporan.FotoLaporan" class="control-label">Foto Laporan</label>
        <input type="file" asp-for="Laporan.FotoLaporan" name="fotoLaporan" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Laporan.FileLaporan" class="control-label">File Laporan</label>
        <input type="file" asp-for="Laporan.FileLaporan" name="file" class="form-control" />
    </div>
    <div class="form-group">
        <input type="submit" value="Create" class="btn" />
    </div>
</form>

</div>

<div class="container py-5">
    <h1 class="display-4 mb-4">Create Laporan</h1>
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <h4 class="card-title mb-4">Laporan Details</h4>
                    <form asp-action="CreateLaporan"  enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="Laporan.IdMahasiswa" />
                        <input type="hidden" asp-for="Laporan.IdProyek" />


                        <div class="mb-3">
                            <label asp-for="Laporan.Keterangan" class="form-label">Keterangan</label>
                            <input asp-for="Laporan.Keterangan" class="form-control" />
                            <span asp-validation-for="Laporan.Keterangan" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Laporan.FotoLaporan" class="form-label">Foto Laporan</label>
                            <input asp-for="Laporan.FotoLaporan" type="file" name="img" class="form-control" />
                            <span asp-validation-for="Laporan.FotoLaporan" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Laporan.FileLaporan" class="form-label">File Laporan</label>
                            <input asp-for="Laporan.FileLaporan" type="file" name="file" class="form-control" />
                            <span asp-validation-for="Laporan.FileLaporan" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Create</button>
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
