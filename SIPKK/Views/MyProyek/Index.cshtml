@model MyProyekVM

<h2>Proyek Kamu</h2>
<div>
    <h3>@Model.Mahasiswa.FirstName</h3>
    <p>Program Studi: @Model.Mahasiswa.ProgramStudi.Nama</p>
    <p>Konsentrasi: @Model.Mahasiswa.Konsentrasi.Nama</p>
</div>

<h2>Detail Proyek</h2>
@if(Model.Proyek != null)
{
    <div>
        <h3>@Model.Proyek.NamaProyek</h3>
        <p>Deskripsi: @Model.Proyek.Deskripsi</p>
        @if(!string.IsNullOrEmpty(Model.Proyek.FotoProyek))
        {
            <p>Foto Proyek: <img src="@Model.Proyek.FotoProyek" alt="Foto Proyek" /></p>
        }
    </div>
}
else
{
    <p>Kamu belum mendaftar ke proyek manapun</p>
}

<h2>Detail Laporan</h2>
@if(Model.Laporan != null)
{
    <div>
        <h3>@Model.Laporan.Keterangan</h3>
        @if(!string.IsNullOrEmpty(Model.Laporan.FotoLaporan))
        {
            <p>Foto Proyek: <img src="@Model.Laporan.FotoLaporan" alt="Foto Proyek" /></p>
        }
    </div>
}
else
{
    <a asp-action="CreateLaporan">Create Laporan</a>
}
<h2>Detail Pendaftaran</h2>
@if(Model.Pendaftaran != null)
{
    <div>
        <h3>Tanggal: @Model.Pendaftaran.TanggalPendaftaran</h3>
        <p>StatusPembayaran: @Model.Pendaftaran.StatusPembayaran</p>
    </div>
}
else
{
    <p>Tidak ada pendaftaran yang ditemukan.</p>
}