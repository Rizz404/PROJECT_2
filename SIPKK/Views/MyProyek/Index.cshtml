@model MyProyekVM
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var roles = await UserManager.GetRolesAsync(user);
}


<partial name="_Notification" />

<div class="container mt-4">
    <h2 class="mb-4">Proyek Kamu</h2>

    @if (Model.Proyek != null)
    {
        <div class="card mb-4 shadow">
            @if (!string.IsNullOrEmpty(Model.Proyek.FotoProyek))
            {
                <img src="@Model.Proyek.FotoProyek" alt="Foto Proyek" class="my-proyek-foto">
            }
            else
            {
                <img src="~/images/contextual/project.svg" class="card-img-top" alt="Default Proyek Image">
            }
            <div class="card-body">
                <h5 class="card-title">@Model.Proyek.NamaProyek</h5>
                <p class="card-text">@Model.Proyek.Deskripsi</p>
                <div class="my-2 d-flex gap-2 flex-wrap">
                    <span class="badge bg-primary">@Model.Proyek.Kuota</span>
                    <span class="badge bg-secondary">@Model.Proyek.Lokasi</span>
                    <span class="badge @(Model.Proyek.Verified ? "bg-success" : "bg-warning")">
                        @(Model.Proyek.Verified ? "Sudah Terverifikasi" : "Belum Terverifikasi")
                    </span>
                    <span class="badge @(Model.Proyek.SudahSelesai ? "bg-success" : "bg-danger")">
                        @(Model.Proyek.SudahSelesai ? "Sudah Selesai" : "Belum Selesai")
                    </span>
                </div>
            </div>
        </div>

        <div class="card mb-4 shadow">
            <div class="card-header">
                <h3 class="mb-0">Anggota Proyek </h3>
            </div>
            <div class="card-body">
                @if (Model.Dosen != null)
                {
                    <div class="card mb-4 shadow">
                        <div class="card-header">
                            <h3 class="mb-0"> Dosen Pembimbing</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    @if (!string.IsNullOrEmpty(Model.Dosen.FotoProfil))
                                    {
                                        <img src="@Model.Dosen.FotoProfil" alt="Foto Profil Dosen" class="img-fluid rounded-circle mb-3" style="width: 200px; height: 200px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <img src="~/images/contextual/account.svg" alt="Default Foto Profil Dosen" class="img-fluid rounded-circle mb-3" style="width: 200px; height: 200px; object-fit: cover;">
                                    }
                                </div>
                                <div class="col-md-8">
                                    <h4 class="mb-3">@Model.Dosen.NamaDosen</h4>
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item"><strong>NIDN:</strong> @Model.Dosen.NIDN</li>
                                        <li class="list-group-item"><strong>Tanggal Lahir:</strong> @Model.Dosen.TanggalLahir.ToString("dd MMMM yyyy")</li>
                                        @if (!string.IsNullOrEmpty(Model.Dosen.IdProyek))
                                        {
                                            <li class="list-group-item"><strong>ID Proyek:</strong> @Model.Dosen.IdProyek</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        Belum ada dosen pembimbing yang ditugaskan untuk proyek ini.
                    </div>
                }                <div class="table-responsive">


                    @if (roles.Contains("Mahasiswa"))
                    {
                        @if (Model.Proyek.TipeProyek == Proyek.Tipe.KKP)
                        {
                            @if (Model.Proyek.Mahasiswa != null)
                            {
                                <table class="table table-striped table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>NIM</th>
                                            <th>Nama Depan</th>
                                            <th>Nama Belakang</th>
                                            <th>Tanggal Lahir</th>
                                            <th>Foto Profil</th>
                                            <th>Nilai</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var mahasiswa in Model.Proyek.Mahasiswa)
                                        {
                                            <tr>
                                                <td>@mahasiswa.NIM</td>
                                                <td>@mahasiswa.FirstName</td>
                                                <td>@mahasiswa.LastName</td>
                                                <td>@mahasiswa.TanggalLahir.ToString("dd-MM-yyyy")</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(mahasiswa.FotoProfil))
                                                    {
                                                        <img src="@mahasiswa.FotoProfil" alt="Foto Profil" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <img src="~/images/contextual/account.svg" alt="Default Foto Profil" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;" />
                                                    }
                                                </td>
                                                <td>@mahasiswa.Nilai</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="heading">
                                    belum ada mahasiswa
                                </p>
                            }
                        }
                        else
                        {
                            @if (Model.MyKelompok != null)
                            {
                                <table class="table table-striped table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>NIM</th>
                                            <th>Nama Depan</th>
                                            <th>Nama Belakang</th>
                                            <th>Tanggal Lahir</th>
                                            <th>Foto Profil</th>
                                            <th>Nilai</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var mahasiswa in Model.MyKelompok.Mahasiswa)
                                        {
                                            <tr>
                                                <td>@mahasiswa.NIM</td>
                                                <td>@mahasiswa.FirstName</td>
                                                <td>@mahasiswa.LastName</td>
                                                <td>@mahasiswa.TanggalLahir.ToString("dd-MM-yyyy")</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(mahasiswa.FotoProfil))
                                                    {
                                                        <img src="@mahasiswa.FotoProfil" alt="Foto Profil" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <img src="~/images/contextual/account.svg" alt="Default Foto Profil" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;" />
                                                    }
                                                </td>
                                                <td>
                                                    @mahasiswa.Nilai
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="heading">
                                    belum ada mahasiswa
                                </p>
                            }
                        }
                    }
                    else
                    {
                        @if (Model.Proyek.TipeProyek == Proyek.Tipe.KKP)
                        {
                            @if (Model.Proyek.Mahasiswa != null)
                            {
                                <table class="table table-striped table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>NIM</th>
                                            <th>Nama Depan</th>
                                            <th>Nama Belakang</th>
                                            <th>Tanggal Lahir</th>
                                            <th>Foto Profil</th>
                                            <th>Nilai</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var mahasiswa in Model.Proyek.Mahasiswa)
                                        {
                                            <tr>
                                                <td>@mahasiswa.NIM</td>
                                                <td>@mahasiswa.FirstName</td>
                                                <td>@mahasiswa.LastName</td>
                                                <td>@mahasiswa.TanggalLahir.ToString("dd-MM-yyyy")</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(mahasiswa.FotoProfil))
                                                    {
                                                        <img src="@mahasiswa.FotoProfil" alt="Foto Profil" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <img src="~/images/contextual/account.svg" alt="Default Foto Profil" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;" />
                                                    }
                                                </td>
                                                <td rowspan="2">
                                                    @if (@Model.Proyek.Verified == true) {

                                                        <form asp-action="UpdateNilai" method="post">
                                                            <input type="hidden" name="Id" value="@mahasiswa.Id" />
                                                            <input type="number" name="nilai" class="form-control" placeholder="Masukkan Nilai" value="@mahasiswa.Nilai" />
                                                            <button type="submit" class="btn btn-primary mt-2">Submit</button>
                                                        </form>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="heading">
                                    belum ada mahasiswa
                                </p>
                            }
                        }
                        else
                        {
                            @if (Model.KelompokList != null)
                            {
                                @foreach (var kelompok in Model.KelompokList)
                                {
                                    <table class="table table-striped table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Nama Kelompok</th>
                                                <th>Nama Ketua</th>
                                                <th>Nilai</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>@kelompok.NamaKelompok</td>
                                                <td>@kelompok.NamaKetua</td>
                                                <td rowspan="2">

                                                    @if (@Model.Proyek.Verified == true)
                                                    {
                                                        <form asp-action="UpdateNilaiKelompok" method="post">
                                                            <input type="hidden" name="Id" value="@kelompok.Id" />
                                                            <input type="number" name="nilai" class="form-control" placeholder="Masukkan Nilai" value="@kelompok.Nilai" />
                                                            <button type="submit" class="btn btn-primary mt-2">Submit</button>
                                                        </form>    
                                                    }

                                                    
                                                </td>
                                            </tr>
                                            <tr>
                                               <td>Anggota</td>
                                               <td>
                                                         @foreach (var anggota in kelompok.Mahasiswa)
                                                         {
                                                              <p>
                                                            @anggota.FirstName @anggota.LastName
                                                              </p>
                                                         }
                                            </tr>
                                        </tbody>
                                    </table>
                                }

                            }
                            else
                            {
                                <p class="heading">
                                    belum ada mahasiswa
                                </p>
                            }
                        }
                    }

                </div>
            </div>
        </div>

        @if (Model.Proyek.Verified)
        {
            @if (Model.Proyek.SudahSelesai == false && Model.Mahasiswa != null && (Model.Mahasiswa.RoleMahasiswa == Mahasiswa.Role.KETUA || !string.IsNullOrEmpty(Model.Mahasiswa.IdProyekKKP)))
            {
                <a asp-action="CreateLaporan" class="btn btn-primary mb-4">Buat Laporan</a>
                <a asp-action="CreateBiayaOperasional" class="btn btn-primary mb-4">Buat Laporan Biaya Operasional</a>
            }
            <a asp-action="Laporan" class="btn btn-warning mb-4">Detail Laporan</a>
            <a asp-action="BiayaOperasional" class="btn btn-warning mb-4">Detail Biaya Operasional</a>
        }
    }
    else
    {
        <div class="alert alert-info" role="alert">
            Kamu belum mendaftar ke proyek manapun
        </div>
    }
</div>