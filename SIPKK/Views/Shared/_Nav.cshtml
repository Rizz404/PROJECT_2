@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
}
<header>
    <nav class="base-container flex-center bg-white py-3 px-5 shadow-sm rounded">
        <div class="logo-container flex-center">
            <a asp-area="" asp-controller="Home" asp-action="Index">
            </a>
            <!--
                <h1 class="title">
                KknHub
            </h1>
            -->
        </div>
        <ul class="flex-center mb-0">

            @if(SignInManager.IsSignedIn(User) && user != null)
            {
                var roles = await UserManager.GetRolesAsync(user);
                var currentUser = await UserManager.GetUserAsync(User);

                @if(roles.Contains("Mahasiswa"))
                {
                    <li>
                        <a asp-area="" asp-controller="Proyek" asp-action="Index">Proyek</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="Profile" asp-action="Index">Profile</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="MyProyek" asp-action="Index">My Proyek</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="MyProyek" asp-action="Laporan">Laporan</a>
                    </li>

                }
                else if(roles.Contains("Dosen"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Proyek" asp-action="Index">Proyek</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Profile" asp-action="Index">Profile</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="MyProyek" asp-action="Index">My Proyek</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="MyProyek" asp-action="Laporan">Laporan</a>
                    </li>
                }
            }


        </ul>
        <div class="auth-container flex-center">
            @if(SignInManager.IsSignedIn(User) && user != null)
            {
                <a id="manage" class="primary-btn" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @UserManager.GetUserName(User)!</a>
                <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button id="logout" type="submit" class="primary-btn">Logout</button>
                </form>
            }
            else
            {
                <a class="primary-btn" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
                <a class="primary-btn" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
            }

        </div>
    </nav>


</header>
