@if(TempData["ErrorMessage"] != null)
{
    if(TempData["ErrorMessage"] is string)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    else if(TempData["ErrorMessage"] is IEnumerable<string>)
    {
        foreach(var message in (IEnumerable<string>)TempData["ErrorMessage"])
        {
            <div class="alert alert-danger">@message</div>
        }
    }
}

@if(TempData["SuccessMessage"] != null)
{
    if(TempData["SuccessMessage"] is string)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    else if(TempData["SuccessMessage"] is IEnumerable<string>)
    {
        foreach(var message in (IEnumerable<string>)TempData["SuccessMessage"])
        {
            <div class="alert alert-success">@message</div>
        }
    }
}
