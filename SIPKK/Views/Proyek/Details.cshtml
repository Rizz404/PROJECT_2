@using Microsoft.AspNetCore.Identity
@model ProyekVM

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var roles = await UserManager.GetRolesAsync(user);
}

<div class="row">
    <div class="">
        <partial name="_Notification" />
        <div class="card mb-3">
            @if(Model.Proyek.FotoProyek != null)
            {
                <img src="@Model.Proyek.FotoProyek" class="card-img-top" alt="...">
            }
            else
            {
                <img src="https://i.pinimg.com/236x/f3/14/eb/f314eb2a3b3516819825da700929c83d.jpg" class="card-img-top" alt="...">
            }
            <div class="card-body">
                <h5 class="card-title">@Model.Proyek.NamaProyek</h5>
                <p class="card-text">@Model.Proyek.Deskripsi</p>
                <div class="my-2 d-flex gap-2 flex-wrap">
                    <button class="btn btn-danger badge">@Model.Proyek.Kuota</button>
                    <button class="btn btn-danger badge">@Model.Proyek.Lokasi</button>
                </div>


                @if(roles.Contains("Mahasiswa"))
                {
                    @if(Model.IsMahasiswaTerdaftar)
                    {
                        <button type="submit" class="btn btn-success" disabled>Terdaftar</button>
                    }
                    else
                    {
                        <form asp-action="Daftar" method="post">
                            <input type="hidden" name="id" value="@Model.Proyek.Id" />
                            <button type="submit" class="btn btn-primary">Daftar</button>
                        </form>
                    }
                }
                else if(roles.Contains("Dosen"))
                {
                    <form asp-action="DaftarForDosen" method="post">
                        <input type="hidden" name="id" value="@Model.Proyek.Id" />
                        <button type="submit" class="btn btn-primary">Jadi pembimbing</button>
                    </form>
                }
                else if(roles.Contains("Admin"))
                {
                    <button type="button" class="btn btn-success" disabled>Youre gay</button>
                }

            </div>
        </div>

        <div>
            <h3>Mahasiswa Terdaftar</h3>
            <ul class="list-group mb-2">
                @foreach(var mahasiswa in Model.Proyek.Mahasiswa)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @mahasiswa.FirstName
                        <span>Pending</span>
                    </li>
                }

            </ul>
        </div>
    </div>
</div>