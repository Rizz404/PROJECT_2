@using Microsoft.AspNetCore.Identity
@model ProyekVM

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var roles = await UserManager.GetRolesAsync(user);
    string[] rules = {
        "Integritas dan Kejujuran",
        "Etika dan Sikap Profesional",
        "Penghormatan terhadap Budaya dan Adat Setempat",
        "Tanggung Jawab Sosial",
        "Kepatuhan terhadap Hukum dan Peraturan",
        "Kerja Sama Tim",
        "Adaptabilitas dan Fleksibilitas",
        "Pelaporan yang Tepat Waktu dan Akurat"
    };

    var routeUploadBiayaPendaftaran = $"/Pendaftaran/UploadBiayaPendaftaran/{Model.Proyek.Id}";
    var routeCreateKelompok = $"/Kelompok/Create/{Model.Proyek.Id}";
}

<div class="base-container">
    <partial name="_Notification" />
</div>

<div class="proyek-wrapper base-container">
    <h1 class="proyek-title ">
        @Model.Proyek.NamaProyek
    </h1>
    <div class="proyek-container">
        <div class="proyek-inner">
            <div class="proyek-foto-container">
                @if (Model.Proyek.FotoProyek != null)
                {
                    <img class="proyek-foto" src="@Model.Proyek.FotoProyek" alt="...">
                }
                else
                {
                    <img src="~/images/contextual/project.svg" class="proyek-foto" alt="...">
                }
                <img src="/images/assets/tagline.png" class="proyek-tagline" />
            </div>
            <div class="proyek-container-detail">
                <div class="proyek-detail">
                    <div class="proyek-inner-detail">
                        <div>
                            <div>
                                <p>From:</p><span>@Model.Proyek.TanggalMulai</span>
                            </div>
                            <div>
                                <p>Location:</p><span>@Model.Proyek.Lokasi</span>
                            </div>
                        </div>
                    </div>
                    <div class="proyek-inner-detail">
                        <div>
                            <div>
                                <p>Until:</p><span>@Model.Proyek.TanggalSelesai</span>
                            </div>
                            <div>
                                <p>Tipe Proyek:</p><span>@Model.Proyek.TipeProyek</span>
                            </div>
                            <div>
                                @if (Model.MahasiswaTerdaftar == Model.Proyek.Kuota)
                                {
                                    <p>Penuh</p>
                                }
                                else
                                {
                                    @if (Model.MahasiswaTerdaftar == Model.Proyek.Kuota)
                                    {
                                        <p>Penuh</p>
                                    }
                                    else
                                    {
                                        <p>Kuota: </p>

                                        <span>@Model.MahasiswaTerdaftar / @Model.Proyek.Kuota</span>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
                @if (SignInManager.IsSignedIn(User))
                {
                    @if (roles.Contains("Mahasiswa"))
                    {
                        if (Model.Proyek.TipeProyek == Proyek.Tipe.KKP)
                        {
                            if (Model.StatusTerdaftar == ProyekVM.Status.TIDAK_TERDAFTAR)
                            {
                                <form asp-action="DaftarKKP" method="post">
                                    <input type="hidden" name="id" value="@Model.Proyek.Id" />
                                    <button type="submit" class="btn btn-primary">Daftar KKP</button>
                                </form>
                            }
                            else if (Model.StatusTerdaftar == ProyekVM.Status.TERDAFTAR && Model.Mahasiswa.IdProyekKKP != null)
                            {
                                <button type="button" class="btn btn-primary">Terdaftar</button>
                            }
                            else if (Model.StatusTerdaftar == ProyekVM.Status.TERDAFTAR_PROYEK_LAIN)
                            {
                                <button type="button" class="btn btn-primary">Terdaftar di proyek lain</button>

                            }
                        }
                        else if (Model.Proyek.TipeProyek == Proyek.Tipe.KKN)
                        {
                            if (Model.StatusTerdaftar == ProyekVM.Status.TIDAK_TERDAFTAR)
                            {
                                if (Model.Mahasiswa.RoleMahasiswa == Mahasiswa.Role.KETUA)
                                {
                                    <a href="@routeCreateKelompok" class="btn btn-primary">Buat Kelompok</a>

                                }
                                else if (Model.RoleMahasiswa == null)
                                {
                                    <a asp-controller="Profile" asp-action="Index" class="btn btn-primary">Ubah Role kamu dulu agar bisa join kkn</a>
                                }
                                else if (Model.RoleMahasiswa == Mahasiswa.Role.ANGGOTA)
                                {
                                    <span class="btn btn-success badge">Silahkan join kelompok yang tersedia</span>
                                }
                            }
                            else if (Model.StatusTerdaftar == ProyekVM.Status.TERDAFTAR && Model.Mahasiswa.IdKelompok!= null)
                            {
                                <button type="button" class="btn btn-primary">Terdaftar</button>
                            }
                            else if (Model.StatusTerdaftar == ProyekVM.Status.TERDAFTAR_PROYEK_LAIN)
                            {
                                <button type="button" class="btn btn-primary">Terdaftar di proyek lain</button>

                            }
                        }
                    }
                    else if (roles.Contains("Dosen"))
                    {
                        if (Model.StatusTerdaftar == ProyekVM.Status.TIDAK_TERDAFTAR && Model.Proyek.Dosen.Count == 0)
                        {
                            <form asp-action="DaftarJadiPembimbing" method="post">
                                <input type="hidden" name="id" value="@Model.Proyek.Id" />
                                <button type="submit" class="btn btn-primary">Jadi pembimbing</button>
                            </form>
                        }
                        else if (Model.Proyek.Id == Model.Dosen.IdProyek)
                        {   
                            <button type="button" class="btn btn-primary">Terdaftar</button>
                        } else
                        {
                            <button type="button" class="btn btn-primary">Sudah ada dosen pembimbing</button>
                        }

                    }
                    else if (roles.Contains("Admin"))
                    {
                        <button type="button" class="btn btn-success" disabled>Youre gay</button>
                    }
                }
            </div>
            <div class="proyek-deskripsi">
                <h2 class="proyek-subtitle">
                    Description
                </h2>
                <p>
                    @Model.Proyek.Deskripsi
                </p>
            </div>
            <div>
                @if (Model.Proyek.TipeProyek == Proyek.Tipe.KKN)
                {
                    @foreach (var kelompok in Model.Proyek.Kelompok)
                    {
                        <div class="card mb-2">
                            <span>Nama Kelompok: @kelompok.NamaKelompok</span>
                            <span>Nama ketua @kelompok.NamaKetua</span>
                            <div>
                                @foreach (var mahasiswa in kelompok.Mahasiswa)
                                {
                                    if (mahasiswa.RoleMahasiswa == Mahasiswa.Role.KETUA)
                                    {
                                        <p>@mahasiswa.FirstName (ketua)</p>
                                    }
                                    else
                                    {
                                        <p>@mahasiswa.FirstName</p>
                                    }
                                }
                            </div>

                            @if (roles.Contains("Mahasiswa") && Model.RoleMahasiswa != null && Model.RoleMahasiswa != Mahasiswa.Role.KETUA)
                            {
                                @if (Model.StatusTerdaftar == ProyekVM.Status.TIDAK_TERDAFTAR && kelompok.Mahasiswa.Count <= kelompok.Kuota)
                                {
                                    <form asp-action="JoinKelompok" method="post">
                                        <input type="hidden" name="id" value="@kelompok.Id" />
                                        <button type="submit" class="btn btn-primary">Join</button>
                                    </form>
                                }
                            }
                        </div>
                    }
                }
                else
                {
                    <ul>
                        @foreach (var mahasiswa in Model.Proyek.Mahasiswa)
                        {
                            <li>@mahasiswa.FirstName</li>
                        }
                    </ul>
                }
            </div>
            <div>
                @if (Model.Proyek.Verified == true && Model.Proyek.SudahSelesai == false)
                {
                    <button>Berjalan</button>
                }
                else if (Model.Proyek.SudahSelesai == true)
                {
                    <button>Selesai</button>
                }
            </div>
        </div>
        <div class="proyek-rules">
            <h2 class="proyek-subtitle">
                Rules
            </h2>
            <ol>
                @foreach (var rule in rules)
                {
                    <li>@rule</li>
                }
            </ol>
        </div>
    </div>
</div>
</div>