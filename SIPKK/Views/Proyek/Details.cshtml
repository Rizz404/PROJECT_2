@using Microsoft.AspNetCore.Identity
@model ProyekVM

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var roles = await UserManager.GetRolesAsync(user);
    string[] rules = {
        "Integritas dan Kejujuran",
        "Etika dan Sikap Profesional",
        "Penghormatan terhadap Budaya dan Adat Setempat",
        "Tanggung Jawab Sosial",
        "Kepatuhan terhadap Hukum dan Peraturan",
        "Kerja Sama Tim",
        "Adaptabilitas dan Fleksibilitas",
        "Pelaporan yang Tepat Waktu dan Akurat"
    };

    var routeUploadBiayaPendaftaran = $"/Pendaftaran/UploadBiayaPendaftaran/{Model.Proyek.Id}";

}

<div class="base-container">
    <partial name="_Notification" />

    </div>
<div class="hidden">
    <div class="">
        <div ">
        @if(Model.Proyek.FotoProyek != null)
        {
                <img src="@Model.Proyek.FotoProyek" alt="...">
        }
        else
        {
                <img src="https://i.pinimg.com/236x/f3/14/eb/f314eb2a3b3516819825da700929c83d.jpg" class="card-img-top" alt="...">
        }
            <div>
                <h5>@Model.Proyek.NamaProyek</h5>
                <p>@Model.Proyek.Deskripsi</p>
                <div>
                    <button>@Model.Proyek.Kuota</button>
                    <button>@Model.Proyek.Lokasi</button>
        @if(Model.Proyek.Verified == true && Model.Proyek.SudahSelesai == false)
        {
                        <button>Berjalan</button>
        }
        else if(Model.Proyek.SudahSelesai == true)
        {
                        <button>Selesai</button>
        }
                </div>
        @if(SignInManager.IsSignedIn(User))
        {
            @if(roles.Contains("Mahasiswa"))
            {
                @if(Model.StatusMahasiswa == ProyekVM.Status.PENDING)
                {
                            <span>terdaftar di proyek  <span class="btn btn-success badge"> @Model.ProyekTerdaftarNameForCurrentMahasiswa</span> menungu konfirmasi pembayaran</span>
                }
                else if(Model.StatusMahasiswa == ProyekVM.Status.TERDAFTAR)
                {
                            <span class="btn btn-success badge">Terdaftar</span>
                }
                else if(Model.StatusMahasiswa == ProyekVM.Status.TERDAFTAR_PROYEK_LAIN)
                {
                            <span class="btn btn-secondary badge">Terdaftar Proyek Lain</span>
                }
                else
                {
                            <a href="@routeUploadBiayaPendaftaran" class="btn btn-primary">Daftar</a>
                }
            }
            else if(roles.Contains("Dosen"))
            {
                @switch(Model.StatusMahasiswa) // Perhatikan: kita menggunakan StatusMahasiswa untuk dosen juga
                {
                    case ProyekVM.Status.TERDAFTAR:
                            <span class="btn btn-success badge">Proyek Anda</span>
                    break;
                    case ProyekVM.Status.TERDAFTAR_PROYEK_LAIN:
                            <span>Anda terdaftar di proyek lain: <span class="btn btn-info badge">@Model.ProyekTerdaftarNameForCurrentMahasiswa</span></span>
                    break;
                    default:
                            <form asp-action="DaftarJadiPembimbing" method="post">
                                <input type="hidden" name="id" value="@Model.Proyek.Id" />
                                <button type="submit" class="btn btn-primary">Jadi pembimbing</button>
                            </form>
                    break;
                }
            }
            else if(roles.Contains("Admin"))
            {
                        <button type="button" class="btn btn-success" disabled>Youre gay</button>
            }
        }

            </div>
        </div>

        <div>
            <h3>Mahasiswa Terdaftar</h3>
            <ul>
        @foreach(var mahasiswa in Model.Proyek.Mahasiswa)
        {
                    <li>
                @mahasiswa.FirstName
                        <span>Pending</span>
                    </li>
        }

            </ul>
        </div>
    </div>
</div>


<div class="proyek-wrapper base-container">
    <h1 class="proyek-title ">
        @Model.Proyek.NamaProyek
    </h1>
    <div class="proyek-container">
        <div class="proyek-inner">
            <div class="proyek-foto-container">
        @if(Model.Proyek.FotoProyek != null)
        {
                    <img class="proyek-foto" src="@Model.Proyek.FotoProyek" alt="...">
        }
        else
        {
                    <img src="https://i.pinimg.com/236x/f3/14/eb/f314eb2a3b3516819825da700929c83d.jpg" class="proyek-foto" alt="...">
        }
                <img src="/images/assets/tagline.png" class="proyek-tagline" />
            </div>
            <div class="proyek-container-detail">
                <div class="proyek-detail">
                    <div class="proyek-inner-detail">
                        <div>
                            <div>
                                <p>
                                    From:
                                </p>
                                <span>
                            @Model.Proyek.TanggalMulai
                                </span>
                            </div>
                            <div>
                                <p>
                                    Location:
                                </p>
                                <span>
                            @Model.Proyek.Lokasi
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="proyek-inner-detail">
                        <div>
                            <div>
                                <p>
                                    Until:
                                </p>
                                <span>
                            @Model.Proyek.TanggalSelesai
                                </span>
                            </div>
                            <div>
                                <p>
                                    Kuota:
                                </p>
                                <span>
                            @Model.MahasiswaTerdaftar / @Model.Proyek.Kuota
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
        @if (SignInManager.IsSignedIn(User))
        {
            @if (roles.Contains("Mahasiswa"))
            {
                @if (Model.StatusMahasiswa == ProyekVM.Status.PENDING)
                {
                    <span class="btn btn-success badge">
                        Menunggu Konfirmasi Pembayaran
                    </span>
                }
                else if (Model.StatusMahasiswa == ProyekVM.Status.TERDAFTAR)
                {
                            <span class="btn btn-success badge">Terdaftar</span>
                }
                else if (Model.StatusMahasiswa == ProyekVM.Status.TERDAFTAR_PROYEK_LAIN)
                {
                            <span class="btn btn-secondary badge">Terdaftar Proyek Lain</span>
                }
                else
                {
                            <a href="@routeUploadBiayaPendaftaran" class="orange-btn">Daftar</a>
                }
            }
            else if (roles.Contains("Dosen"))
            {
                @switch (Model.StatusMahasiswa) // Perhatikan: kita menggunakan StatusMahasiswa untuk dosen juga
                {
                    case ProyekVM.Status.TERDAFTAR:
                                <span class="btn btn-success badge">Proyek Anda</span>
                        break;
                    case ProyekVM.Status.TERDAFTAR_PROYEK_LAIN:
                                <span>Anda terdaftar di proyek lain: <span class="btn btn-info badge">@Model.ProyekTerdaftarNameForCurrentMahasiswa</span></span>
                        break;
                    default:
                                <form asp-action="DaftarJadiPembimbing" method="post">
                                    <input type="hidden" name="id" value="@Model.Proyek.Id" />
                                    <button type="submit" class="btn btn-primary">Jadi pembimbing</button>
                                </form>
                        break;
                }
            }
            else if (roles.Contains("Admin"))
            {
                        <button type="button" class="btn btn-success" disabled>Youre gay</button>
            }
        }
            </div>
            <div class="proyek-deskripsi">
                <h2 class="proyek-subtitle">
                    Description
                </h2>
                <p>
            @Model.Proyek.Deskripsi
                </p>
            </div>
            <div>
        @if (Model.Proyek.Verified == true && Model.Proyek.SudahSelesai == false)
        {
                    <button>Berjalan</button>
        }
        else if (Model.Proyek.SudahSelesai == true)
        {
                    <button>Selesai</button>
        }
            </div>
    </div>
            <div class="proyek-rules">
                <h2 class="proyek-subtitle">
                    Rules
                </h2>
                <ol>
            @foreach(var rule in rules)
            {
                        <li>@rule</li>
            }
                </ol>
            </div>
        </div>
    </div>
</div>

