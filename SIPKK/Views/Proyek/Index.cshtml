<partial name="_Notification" />
<div class="base-container proyeks-wrapper">
    @foreach(var proyek in Model)
    {
        if(proyek.Proyek.SudahSelesai)
        {
            <div class="proyeks-container">
                <div class="proyeks-inner">
                    @if(!string.IsNullOrEmpty(proyek.Proyek.FotoProyek))
                    {
                        <img class="proyeks-foto" src="@proyek.Proyek.FotoProyek" alt="...">
                    }
                    else
                    {
                        <img class="proyeks-foto" src="https://i.pinimg.com/236x/fd/1e/00/fd1e00edba3b36fc06341ad96ab7329d.jpg" class="card-img-top" alt="...">
                    }
                    <div class="proyeks-detail">
                        <h5 class="proyeks-nama">@proyek.Proyek.NamaProyek</h5>
                        <p class="proyeks-deskripsi">@proyek.Proyek.Deskripsi</p>
                        <div class="proyeks-inner-detail">
                            <div class="proyeks-kuota-lokasi">
                                @if(proyek.MahasiswaTerdaftar == proyek.Proyek.Kuota)
                                {
                                    <p>
                                        Penuh
                                    </p>
                                }
                                else
                                {
                                    <p>Kuota: @proyek.MahasiswaTerdaftar / @proyek.Proyek.Kuota</p>
                                }
                                <p>
                                    @proyek.Proyek.Lokasi
                                </p>
                            </div>
                            <p>
                                Sudah Selesai
                            </p>
                        </div>
                    </div>
                    <div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <a class="proyeks-container" asp-action="Details" asp-route-id="@proyek.Proyek.Id">
                <div class="proyeks-inner">
                    @if(!string.IsNullOrEmpty(proyek.Proyek.FotoProyek))
                    {
                        <img class="proyeks-foto" src="@proyek.Proyek.FotoProyek" alt="...">
                    }
                    else
                    {
                        <img class="proyeks-foto" src="https://i.pinimg.com/236x/fd/1e/00/fd1e00edba3b36fc06341ad96ab7329d.jpg" class="card-img-top" alt="...">
                    }
                    <div class="proyeks-detail">
                        <h5 class="proyeks-nama">@proyek.Proyek.NamaProyek</h5>
                        <p class="proyeks-deskripsi">@proyek.Proyek.Deskripsi</p>
                        <div class="proyeks-inner-detail">
                            <div class="proyeks-kuota-lokasi">
                                @if(proyek.MahasiswaTerdaftar == proyek.Proyek.Kuota)
                                {
                                    <p>
                                        Penuh
                                    </p>
                                }
                                else
                                {
                                    <p>Kuota: @proyek.MahasiswaTerdaftar / @proyek.Proyek.Kuota</p>
                                }
                                <p>
                                    @proyek.Proyek.Lokasi
                                </p>
                            </div>
                        </div>
                    </div>
                    <div>
                    </div>
                </div>
            </a>

        }
    }
</div>>
